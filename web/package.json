{
  "name": "@helpwave/tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "build-intl": "npx build-intl -i locales -o ./i18n/translations.ts -n tasksTranslation -f && npx build-intl -i hightide-locales -o ./i18n/hightideLocaleTranslations.ts -n hightideLocaleTranslation -f",
    "build": "npm run build-intl & next build",
    "start": "next start",
    "lint": "tsc --noEmit && eslint .",
    "test": "vitest run",
    "generate-graphql": "graphql-codegen",
    "check-translations": "node scripts/check-translation-keys.mjs"
  },
  "browserslist": [
    "> 0.2%",
    "Firefox ESR",
    "not dead",
    "Android >= 5",
    "Safari >= 8",
    "iOS >= 8",
    "defaults"
  ],
  "overrides": {
    "postcss": "8.5.32",
    "minimatch": "11.0.5"
  },
  "dependencies": {
    "@apollo/client": "4.3.6",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@helpwave/hightide": "0.19.0",
    "@helpwave/internationalization": "0.5.0",
    "@tailwindcss/postcss": "4.3.5",
    "@tanstack/react-query": "5.105.3",
    "@tanstack/react-query-devtools": "5.105.3",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@types/formidable": "3.5.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.9",
    "formidable": "3.5.4",
    "graphql-ws": "6.4.1",
    "lucide-react": "1.67.0",
    "next": "16.4.5",
    "oidc-client-ts": "3.5.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/typescript": "6.1.2",
    "@graphql-codegen/typescript-operations": "6.2.0",
    "@graphql-codegen/typescript-react-query": "7.0.5",
    "@helpwave/eslint-config": "0.0.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.2",
    "baseline-browser-mapping": "2.11.35",
    "eslint": "10.14.0",
    "graphql": "17.0.2",
    "graphql-request": "7.4.0",
    "postcss-flexbugs-fixes": "5.0.2",
    "vitest": "5.1.0"
  }
}